---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__grid">
    <div>
      <a class="brand brand--footer" href="/">
        <img src="/assets/images/norcal-ev-runs-logo-128.webp" alt="" width="88" height="88" loading="lazy" />
        <span>
          <strong>NorCal EV Runs</strong>
          <small>A NorCal EVs community</small>
        </span>
      </a>
    </div>

    <nav class="site-footer__links" aria-label="Footer navigation">
      <a href="https://heylo.group/norcalevruns">Upcoming runs</a>
      <a href="https://www.instagram.com/norcalevruns/">Instagram</a>
      <a href="https://norcalevs.org">NorCal EVs</a>
      <a href="mailto:info@norcalevs.org">Contact</a>
    </nav>
  </div>
  <div class="shell site-footer__legal">
    <p>© {year} NorCal EVs. All rights reserved.</p>
    <p>Drive responsibly. Follow all posted laws and event instructions.</p>
  </div>
</footer>
