---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Route Not Found | NorCal EV Runs"
  description="This route is not on the map. Return to NorCal EV Runs or find the next group drive on Heylo."
>
  <section class="not-found shell">
    <p class="eyebrow">Waypoint 404</p>
    <h1>This road is not on the map.</h1>
    <p>Let’s get you back to the route.</p>
    <div class="button-row">
      <a class="button" href="/">Back home</a>
      <a class="text-link" href="https://heylo.group/norcalevruns">See upcoming runs</a>
    </div>
  </section>
</BaseLayout>
